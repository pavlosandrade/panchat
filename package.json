{
  "name": "panchat",
  "version": "1.0.0",
  "description": "Bot privado de música para Discord usando discord.js e Lavalink v4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "18.0.9",
    "lavalink-client": "2.11.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
